# ASAPTools Environment Variables

# CloudConvert API Key for Word to PDF conversion
# Generate a free API key at https://cloudconvert.com/dashboard/api/v2/keys
CLOUDCONVERT_API_KEY=

# -------------------------------------------------------------
# ASAPTools CodeLab — Sandboxed Code Execution Backend
# -------------------------------------------------------------
# Option 1: Judge0 CE via RapidAPI (Recommended cloud provider)
# 1. Sign up and subscribe for free at:
#    https://rapidapi.com/judge0-official/api/judge0-ce
# 2. Add your RapidAPI key below:
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Option 2: Self-Hosted Judge0 (Docker)
# If running Judge0 on your own server or locally:
# docker run -it -p 2358:2358 judge0/judge0:latest
# JUDGE0_API_URL=http://localhost:2358
# JUDGE0_API_KEY=optional_auth_token_if_enabled

# Option 3: Piston Execution Engine
# If using an open-source Piston instance (or public emkc.org):
# CODE_EXECUTION_PROVIDER=piston
# PISTON_API_URL=https://emkc.org/api/v2/piston
